{
  "name": "presences-enseignants-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de suivi des présences des enseignants à domicile",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "seed:demo": "node --env-file=.env scripts/seed-demo.js",
    "creer-admin": "node --env-file=.env scripts/creer-admin.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 tests/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}

# Environnement : development | production | test
NODE_ENV=development
PORT=4000
# URL publique (HTTPS en production) utilisée dans les QR Codes et les e-mails
URL_PUBLIQUE=http://localhost:5173
# Origine autorisée du back-office (CORS en développement)
ORIGINE_BACKOFFICE=http://localhost:5173
FUSEAU_HORAIRE=Africa/Abidjan

DB_HOTE=127.0.0.1
DB_PORT=3307
DB_NOM=presences_enseignants
DB_UTILISATEUR=presences
DB_MOT_DE_PASSE=presences_dev

# Secrets : générer avec  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_SESSION=a_remplacer
# 64 caractères hexadécimaux (32 octets) pour chiffrer les jetons QR
CLE_CHIFFREMENT_QR=a_remplacer

# Envoi d'e-mails (facultatif). Sans SMTP, le lien de réinitialisation est écrit dans le journal du serveur.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=
